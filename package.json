{
  "name": "beaver-video-editor",
  "private": true,
  "version": "0.3.0",
  "description": "Fast, simple multi-track video editor for Windows (Tauri + React + FFmpeg)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/faisal-shohag/beaver-video-editor.git"
  },
  "homepage": "https://github.com/faisal-shohag/beaver-video-editor",
  "bugs": "https://github.com/faisal-shohag/beaver-video-editor/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
