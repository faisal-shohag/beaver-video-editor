{
  "name": "beaver-video-editor",
  "private": true,
  "version": "0.2.0",
  "description": "Fast, simple multi-track video editor for Windows (Tauri + React + FFmpeg)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/faisal-shohag/beaver-video-editor.git"
  },
  "homepage": "https://github.com/faisal-shohag/beaver-video-editor",
  "bugs": "https://github.com/faisal-shohag/beaver-video-editor/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "ffmpeg:bundle": "powershell -ExecutionPolicy Bypass -File scripts/bundle-ffmpeg.ps1",
    "bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "clsx": "^2.1.1",
    "immer": "^11.1.18",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.22.0"
}
