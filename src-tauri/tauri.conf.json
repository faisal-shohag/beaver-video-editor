{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beaver Video Editor",
  "version": "0.3.0",
  "identifier": "com.beaver.videoeditor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3417",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Beaver Video Editor",
        "width": 1600,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "maximized": true,
        "backgroundColor": "#0d0e11",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/deep-filter"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "Beaver Video Editor contributors",
    "copyright": "Copyright (c) 2026 Beaver Video Editor contributors. MIT License.",
    "homepage": "https://github.com/faisal-shohag/beaver-video-editor",
    "shortDescription": "Fast, simple multi-track video editor",
    "longDescription": "Cut, split, join and speed-change video on a multi-track timeline, then export fast with GPU encoders or losslessly.",
    "category": "Video",
    "resources": {
      "binaries/onnxruntime.dll": "onnxruntime.dll"
    }
  }
}
